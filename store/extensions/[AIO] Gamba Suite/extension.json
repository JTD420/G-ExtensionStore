{
  "title": "[AIO] Gamba Suite",
  "description": "Pkr, 13/21 and Tri dice automated rolling and resetting with in-chat hand evaluation. The all-in-one dice management extension.",
  "authors": [
    {
      "name": "JTD",
      "hotel": ".com",
