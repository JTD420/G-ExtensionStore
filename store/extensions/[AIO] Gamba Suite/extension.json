      "discord": "jtd420"
    }
  ],
  "version": "2.1.0",
  "categories": ["Usability"],

  "source": "https://github.com/JTD420/Gamba-Suite/tree/main",
  "readme": "https://github.com/JTD420/Gamba-Suite/blob/main/README.md",

  "stable": true,

  "framework": {
    "name": "GoEarth",
    "version": "0.3.5"
  },

  "language": "Go",
  "commands": {
    "default": [
      "cmd",
      "/C",
      "Gamba-Suite-win.exe",
      "-c",
      "{cookie}",
      "-p",
      "{port}",
      "-f",
      "{filename}"
    ],
    "windows": [
      "cmd",
      "/C",
      "Gamba-Suite-win.exe",
      "-c",
      "{cookie}",
      "-p",
      "{port}",
      "-f",
      "{filename}"
    ],
    "mac": [
      "/bin/sh", 
      "-c", 
      "chmod +x G-itemViewer-mac && ./G-itemViewer-mac -p \"$1\" -c \"$2\" -f \"$3\"",
       "--", 
       "{port}", 
       "{cookie}", 
       "{filename}"]
  },

  "compatibility": {
    "systems": ["Windows", "Mac"],
    "clients": ["Origins", "Flash"]
  },

